# ── Aplikasi ──
APP_KEY=ganti-dengan-string-acak-minimal-32-karakter
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
TOKEN_TTL_HOURS=12
# Origin app Check-In / Check-Out (pisahkan koma) atau * untuk semua
CORS_ORIGINS=*
# Isi hanya bila dipasang di subfolder dan deteksi otomatis salah, mis. /vsm_pasuruan/4.../public
# APP_BASE_PATH=

# ── Database: pilih salah satu driver ──
# Lokal (XAMPP / MySQL) untuk uji coba
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vsm_pasuruan
DB_USERNAME=root
DB_PASSWORD=

# Vercel (Turso) — set DB_DRIVER=turso di Environment Variables Vercel
TURSO_DATABASE_URL=libsql://nama-db-anda.turso.io
TURSO_AUTH_TOKEN=
